# Скопируйте в .env и настройте под своё окружение.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hero_typing
HOST=127.0.0.1
PORT=5000
# 1 — если PostgreSQL недоступен, приложение поднимется на локальной SQLite
ALLOW_SQLITE_FALLBACK=1
# 1 — заполнить таблицу лидеров демонстрационными игроками
SEED_DEMO_DATA=1
# Домены фронтенда для dev-режима (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
